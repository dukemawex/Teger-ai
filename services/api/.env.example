# Teger AI v1 API — copy to .env (never commit real values)
TEGER_ENV=development                 # development | test | production
# JSON array of key records produced by `python -m teger_api.keys --tenant <id>`
TEGER_API_KEYS=[]
# or: TEGER_API_KEYS_FILE=/run/secrets/teger_api_keys.json
TEGER_REPUTATION_PROVIDER=none        # none | mock  (mock is refused in production)
TEGER_KEY_RATE_LIMIT_PER_MINUTE=60
TEGER_IP_RATE_LIMIT_PER_MINUTE=120
TEGER_MAX_BODY_BYTES=65536
TEGER_TRUST_PROXY_HEADERS=false       # true only behind a proxy that sets X-Forwarded-For
TEGER_CORS_ORIGINS=                   # comma-separated; wildcard is rejected
# TEGER_EXPOSE_DOCS=true              # defaults to false in production

# Teger Intelligence (Claude) — disabled unless both are set
TEGER_AI_ENABLED=false
ANTHROPIC_API_KEY=
TEGER_AI_MODEL=claude-opus-5-5
TEGER_AI_EFFORT=medium                # low | medium | high | xhigh | max
TEGER_AI_MAX_TOKENS=8000
TEGER_AI_TIMEOUT_SECONDS=45
TEGER_AI_MAX_RETRIES=2
TEGER_AI_REFUSAL_FALLBACK=true
TEGER_AI_MAX_CONTENT_CHARS=12000
TEGER_AI_DAILY_TOKEN_BUDGET=200000    # per tenant, per UTC day (server key only)
TEGER_AI_ALLOW_BYOK=true              # users may send their own Anthropic key (X-Anthropic-Api-Key)
